// ThorCraft: restrict the JDK-8360869 aarch64 compiler guard to real GCC.
//
// JDK-8360869 (jdk8u commit ffdc8d89, in 8u502 but not 8u482) added a configure
// check that aborts when TOOLCHAIN_TYPE is gcc, the target is aarch64, and the
// compiler's major version is below 5 -- GCC 4.x miscompiles HotSpot there.
//
// This build passes --with-toolchain-type=gcc while actually compiling with the
// NDK's clang through the android-wrapped-clang shims, so the guard reads
// clang's version and aborts on a compiler it was never about. Requiring the
// compiler to not identify as clang keeps the guard working for genuine GCC and
// unblocks moving the aarch64 pin past 8u482.

diff --git a/common/autoconf/generated-configure.sh b/common/autoconf/generated-configure.sh
index 344c316..155588a 100644
--- a/common/autoconf/generated-configure.sh
+++ b/common/autoconf/generated-configure.sh
@@ -41325,7 +41325,7 @@ $as_echo "$as_me: Rewriting BUILD_LD to \"$new_complete\"" >&6;}
     # This is later checked when setting flags.
   fi
 
-  if test "x$TOOLCHAIN_TYPE" = xgcc; then
+  if test "x$TOOLCHAIN_TYPE" = xgcc && test -z "`$CC --version 2>/dev/null | $GREP -i clang`"; then
     if test "x$OPENJDK_TARGET_CPU_ARCH" = "xaarch64" ; then
       { $as_echo "$as_me:${as_lineno-$LINENO}: checking for broken aarch64 gcc 4.x" >&5
 $as_echo_n "checking for broken aarch64 gcc 4.x... " >&6; }
diff --git a/common/autoconf/toolchain.m4 b/common/autoconf/toolchain.m4
index f27f21a..2704897 100644
--- a/common/autoconf/toolchain.m4
+++ b/common/autoconf/toolchain.m4
@@ -846,7 +846,7 @@ AC_DEFUN_ONCE([TOOLCHAIN_MISC_CHECKS],
     # This is later checked when setting flags.
   fi
 
-  if test "x$TOOLCHAIN_TYPE" = xgcc; then
+  if test "x$TOOLCHAIN_TYPE" = xgcc && test -z "`$CC --version 2>/dev/null | $GREP -i clang`"; then
     if test "x$OPENJDK_TARGET_CPU_ARCH" = "xaarch64" ; then
       AC_MSG_CHECKING([for broken aarch64 gcc 4.x])
       COMPILER_VERSION_NUMBER_MAJOR=`$ECHO "$COMPILER_VERSION_NUMBER" | $SED  "s/@<:@^0-9@:>@.*//"`
