@@ -6200,9 +6200,15 @@ void MacroAssembler::java_round_float(Register dst, FloatRegister src,
 // On other systems, the helper is a usual C function.
 //
 void MacroAssembler::get_thread(Register dst) {
+#ifdef __ANDROID__
+  // Android uses the C++ current-thread helper instead of the Linux
+  // assembly helper. Preserve the complete caller-saved GPR set.
+  RegSet saved_regs = RegSet::range(r0, r17) + lr - dst;
+#else
   RegSet saved_regs =
     LINUX_ONLY(RegSet::range(r0, r1)  + lr - dst)
     NOT_LINUX (RegSet::range(r0, r17) + lr - dst);
+#endif
 
   protect_return_address();
   push(saved_regs, sp);
